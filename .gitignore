# Dependencies
node_modules/

# Build output（仅限本仓库构建产物；注意排除下方插件自带 dist）
out/
release/
dist/
dist-electron/
# 插件目录里的 dist 是随包运行的成品代码，不是构建产物，必须入库
!resources/plugins/*/dist/

# 运行时数据目录：授权文件、插件包、配置、日志全部集中在此（U 盘随包生成）
data/

# Editor
.vscode/
.idea/
*.swp

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*

# 环境私密文件
.env
.env.local

# 原型参考素材（本地比对用，不入库）
.design-refs/

# 本地联调覆盖（不随包分发，交付仍用 resources/app.config.json）
app.config.json
