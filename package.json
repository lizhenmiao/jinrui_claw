{
  "name": "zgy-claw-desktop",
  "version": "3.0.0",
  "private": true,
  "description": "小龙虾 U 盘版客户端：便携式 AI 智能协作伙伴，数据随 U 盘即插即用",
  "main": "src/main/index.js",
  "author": "ZgyClaw",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "dist:win": "node scripts/dist.mjs --win",
    "dist:mac": "node scripts/dist.mjs --mac"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^44.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "com.zgyclaw.desktop",
    "productName": "小龙虾U盘版",
    "copyright": "ZgyClaw Portable",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/main/**",
      "src/preload/**",
      "src/shared/**",
      "out/renderer/**",
      "package.json",
      "node_modules/bytenode/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "forceCodeSigning": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "zgyclaw-windows-amd64.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": null,
      "artifactName": "zgyclaw-mac-${arch}.${ext}"
    }
  },
  "dependencies": {
    "bytenode": "^1.5.7"
  }
}
